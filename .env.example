# Copy to .env (never commit .env). Values are intentionally empty.
# See docs/setup-conturi.md for where each value comes from.

# --- Clerk (auth) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Google Maps Platform ---
# Use SEPARATE, restricted keys per platform (see docs/setup-conturi.md)
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_SERVER=

# --- Database ---
DATABASE_URL=

# --- Monitoring (Sentry) ---
SENTRY_DSN=
